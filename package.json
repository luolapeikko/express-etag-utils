{
  "name": "@avanio/express-etag-utils",
  "version": "0.0.2",
  "description": "ExpressJS ETag utils",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "vitest test --typecheck --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check",
    "validate": "tsc --noEmit --project tsconfig.test.json"
  },
  "files": [
    "dist"
  ],
  "repository": "github:luolapeikko/express-etag-utils",
  "keywords": [
    "etag",
    "express"
  ],
  "author": "mharj",
  "license": "LGPL-2.1-only",
  "bugs": {
    "url": "https://github.com/luolapeikko/express-etag-utils/issues"
  },
  "homepage": "https://github.com/luolapeikko/express-etag-utils#readme",
  "peerDependencies": {
    "etag": "^1.8.1",
    "express": ">=4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@tsconfig/node24": "^24.0.4",
    "@types/etag": "^1.8.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.0.18",
    "c8": "^11.0.0",
    "express": "^5.2.1",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
